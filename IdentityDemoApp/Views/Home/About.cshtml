@{
    ViewData["Title"] = "About Us";
}

<link rel="stylesheet"
      href="~/css/about.css"
      asp-append-version="true" />

<div class="ml-about-page">


    <!-- HERO -->
    <section class="ml-about-hero">
        <div class="container">
            <div class="ml-about-hero-grid">

                <div class="ml-about-hero-content">
                    <span class="ml-about-label">ABOUT MARKETLINK</span>

                    <h1>
                        Connecting Customers
                        <span>With Local Vendors</span>
                    </h1>

                    <p>
                        MarketLink is a digital marketplace designed to connect
                        customers with local vendors and make buying and selling
                        fresh products simple, convenient and reliable.
                    </p>
                </div>

                <div class="ml-about-hero-image">
                    <img src="~/images/farm.webp"
                         alt="MarketLink local marketplace" />
                </div>

            </div>
        </div>
    </section>


    <!-- INTRODUCTION -->
    <section class="ml-about-intro">
        <div class="container">
            <div class="row align-items-center g-5">

                <div class="col-lg-6">
                    <div class="ml-about-image">
                        <img src="~/images/vendor.webp"
                             alt="Local vendors and fresh products" />

                        <div class="ml-about-image-badge">
                            <i class="fas fa-store"></i>

                            <div>
                                <strong>Local Vendors</strong>
                                <span>Connected through MarketLink</span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-lg-6">
                    <span class="ml-section-label">WHO WE ARE</span>

                    <h2>
                        A Simple Marketplace
                        <span>For Everyone</span>
                    </h2>

                    <p>
                        MarketLink provides an online platform where vendors
                        can showcase their products and customers can discover,
                        favourite and order products from vendors.
                    </p>

                    <p>
                        The platform brings vendors and customers together in
                        one convenient place while providing tools for product
                        management, stock availability, orders, pickup slots,
                        reviews and notifications.
                    </p>

                    <div class="ml-about-features">

                        <div class="ml-feature">
                            <div class="ml-feature-icon">
                                <i class="fas fa-store"></i>
                            </div>

                            <div>
                                <h5>Local Vendors</h5>
                                <p>
                                    Discover products from registered vendors.
                                </p>
                            </div>
                        </div>

                        <div class="ml-feature">
                            <div class="ml-feature-icon">
                                <i class="fas fa-cart-shopping"></i>
                            </div>

                            <div>
                                <h5>Easy Shopping</h5>
                                <p>
                                    Browse products and place orders conveniently.
                                </p>
                            </div>
                        </div>

                        <div class="ml-feature">
                            <div class="ml-feature-icon">
                                <i class="fas fa-star"></i>
                            </div>

                            <div>
                                <h5>Reviews & Favourites</h5>
                                <p>
                                    Save products and vendors and share reviews.
                                </p>
                            </div>
                        </div>

                    </div>
                </div>

            </div>
        </div>
    </section>


    <!-- HOW IT WORKS -->
    <section class="ml-how-section">
        <div class="container">

            <div class="ml-section-heading">
                <span class="ml-section-label">HOW IT WORKS</span>

                <h2>
                    MarketLink Makes
                    <span>Things Simple</span>
                </h2>

                <p>
                    A straightforward marketplace experience for both customers
                    and vendors.
                </p>
            </div>

            <div class="row g-4">

                <div class="col-md-4">
                    <div class="ml-step-card">

                        <div class="ml-step-image">
                            <img src="~/images/market shopping.jpg"
                                 alt="Discover products on MarketLink" />
                        </div>

                        <div class="ml-step-number">01</div>

                        <div class="ml-step-icon">
                            <i class="fas fa-magnifying-glass"></i>
                        </div>

                        <h4>Discover</h4>

                        <p>
                            Customers can browse categories, products and
                            vendors to find what they need.
                        </p>

                    </div>
                </div>


                <div class="col-md-4">
                    <div class="ml-step-card">

                        <div class="ml-step-image">
                            <img src="~/images/farm1.webp"
                                 alt="Shop products through MarketLink" />
                        </div>

                        <div class="ml-step-number">02</div>

                        <div class="ml-step-icon">
                            <i class="fas fa-cart-shopping"></i>
                        </div>

                        <h4>Order</h4>

                        <p>
                            Customers can add products to their cart and place
                            orders through the platform.
                        </p>

                    </div>
                </div>


                <div class="col-md-4">
                    <div class="ml-step-card">

                        <div class="ml-step-image">
                            <img src="~/images/marketplace.webp"
                                 alt="Connect with local vendors" />
                        </div>

                        <div class="ml-step-number">03</div>

                        <div class="ml-step-icon">
                            <i class="fas fa-handshake"></i>
                        </div>

                        <h4>Connect</h4>

                        <p>
                            Vendors manage their products and orders while
                            customers receive updates about their purchases.
                        </p>

                    </div>
                </div>

            </div>

        </div>
    </section>


    <!-- PLATFORM FEATURES -->
    <section class="ml-platform-section">
        <div class="container">

            <div class="row align-items-center g-5">

                <div class="col-lg-5">

                    <span class="ml-section-label">OUR PLATFORM</span>

                    <h2>
                        Built For
                        <span>Customers & Vendors</span>
                    </h2>

                    <p>
                        MarketLink provides dedicated features for both sides
                        of the marketplace.
                    </p>

                </div>


                <div class="col-lg-7">

                    <div class="row g-3">

                        <div class="col-sm-6">
                            <div class="ml-platform-card">

                                <i class="fas fa-box"></i>

                                <h5>Product Management</h5>

                                <p>
                                    Vendors can manage their products and
                                    availability.
                                </p>

                            </div>
                        </div>


                        <div class="col-sm-6">
                            <div class="ml-platform-card">

                                <i class="fas fa-calendar-check"></i>

                                <h5>Pickup Slots</h5>

                                <p>
                                    Vendors can provide convenient pickup
                                    time slots.
                                </p>

                            </div>
                        </div>


                        <div class="col-sm-6">
                            <div class="ml-platform-card">

                                <i class="fas fa-heart"></i>

                                <h5>Favourites</h5>

                                <p>
                                    Customers can save their favourite
                                    products and vendors.
                                </p>

                            </div>
                        </div>


                        <div class="col-sm-6">
                            <div class="ml-platform-card">

                                <i class="fas fa-bell"></i>

                                <h5>Notifications</h5>

                                <p>
                                    Users can receive important marketplace
                                    updates.
                                </p>

                            </div>
                        </div>

                    </div>

                </div>

            </div>

        </div>
    </section>


    <!-- CTA -->
    <section class="ml-about-cta">
        <div class="container">

            <div class="ml-cta-box">

                <div>
                    <span class="ml-section-label">GET STARTED</span>

                    <h2>
                        Ready to Explore
                        <span>MarketLink?</span>
                    </h2>

                    <p>
                        Discover products and connect with vendors through
                        MarketLink.
                    </p>
                </div>

                <div class="ml-cta-buttons">

                    <a asp-controller="Home"
                       asp-action="Index"
                       class="ml-btn ml-btn-light">

                        <i class="fas fa-house me-1"></i>
                        Explore MarketLink

                    </a>

                    <a asp-controller="Home"
                       asp-action="Contact"
                       class="ml-btn ml-btn-outline">

                        Contact Us

                    </a>

                </div>

            </div>

        </div>
    </section>
  

</div>
