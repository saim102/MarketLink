
<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - MarketLink
    </title>


    <!-- =====================================================
         BOOTSTRAP
         ===================================================== -->

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />


    <!-- =====================================================
         GOOGLE FONT
         ===================================================== -->

    <link rel="preconnect"
          href="https://fonts.googleapis.com" />

    <link rel="preconnect"
          href="https://fonts.gstatic.com"
          crossorigin />

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap"
          rel="stylesheet" />


    <!-- =====================================================
         FONT AWESOME
         ===================================================== -->

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />


    <!-- =====================================================
         SITE CSS
         ===================================================== -->

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />


    <!-- =====================================================
         FOOTER CSS
         ===================================================== -->

    <link rel="stylesheet"
          href="~/css/footer.css"
          asp-append-version="true" />


    <!-- =====================================================
         SWEET ALERT
         ===================================================== -->

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>


    <!-- =====================================================
         PAGE SPECIFIC CSS
         ===================================================== -->
    @await RenderSectionAsync("Head", required: false)

</head>


<body>


    <!-- =========================================================
         MARKETLINK PREMIUM NAVBAR
         ========================================================= -->

    <header class="ml-premium-navbar">

        <div class="container">

            <div class="ml-navbar-wrapper">


                <!-- =================================================
                     LOGO
                     ================================================= -->

                <a asp-controller="Home"
                   asp-action="Index"
                   class="ml-premium-brand">

                    <span class="ml-brand-mark">
                        <i class="fas fa-leaf"></i>
                    </span>

                    <span class="ml-brand-title">
                        Market<span>Link</span>
                    </span>

                </a>


                <!-- =================================================
                     MOBILE BUTTON
                     ================================================= -->

                <button type="button"
                        class="ml-mobile-button"
                        id="mlMobileButton"
                        aria-label="Open navigation"
                        aria-expanded="false">

                    <span></span>
                    <span></span>
                    <span></span>

                </button>


                <!-- =================================================
                     NAVIGATION
                     ================================================= -->

                <div class="ml-premium-menu"
                     id="mlPremiumMenu">


                    <!-- =================================================
                         NAV LINKS
                         ================================================= -->

                    <nav class="ml-premium-links">

                        <a asp-controller="Home"
                           asp-action="Index"
                           class="ml-premium-link">

                            <i class="fas fa-house"></i>

                            <span>Home</span>

                        </a>


                        <a asp-controller="Home"
                           asp-action="About"
                           class="ml-premium-link">

                            <i class="fas fa-circle-info"></i>

                            <span>About</span>

                        </a>


                        <a asp-controller="Home"
                           asp-action="Products"
                           class="ml-premium-link">

                            <i class="fas fa-basket-shopping"></i>

                            <span>Products</span>

                        </a>


                        <a asp-controller="Home"
                           asp-action="Categories"
                           class="ml-premium-link">

                            <i class="fas fa-layer-group"></i>

                            <span>Categories</span>

                        </a>

                        <a asp-controller="Home"
                           asp-action="Vendors"
                           class="ml-premium-link">

                            <i class="fas fa-store"></i>

                            <span>Vendors</span>

                        </a>


                        <a asp-controller="Home"
                           asp-action="Contact"
                           class="ml-premium-link">

                            <i class="fas fa-envelope"></i>

                            <span>Contact</span>

                        </a>

                    </nav>


                    <!-- =================================================
                         USER ACTIONS
                         ================================================= -->

                    <div class="ml-premium-actions">

                        @if (User.Identity != null &&
                                                User.Identity.IsAuthenticated)
                        {

                            <!-- USER -->

                            <div class="ml-premium-user">

                                <span class="ml-user-avatar">
                                    <i class="fas fa-user"></i>
                                </span>

                                <span class="ml-user-name">
                                    @User.Identity.Name
                                </span>

                            </div>


                            <!-- LOGOUT -->

                            <form asp-controller="Account"
                                  asp-action="Logout"
                                  method="post"
                                  class="ml-logout-form">

                                @Html.AntiForgeryToken()

                                <button type="submit"
                                        class="ml-premium-logout">

                                    <i class="fas fa-right-from-bracket"></i>

                                    <span>Logout</span>

                                </button>

                            </form>

                        }
                        else
                        {

                            <!-- LOGIN -->

                            <a asp-controller="Account"
                               asp-action="Login"
                               class="ml-premium-login">

                                Login

                            </a>


                            <!-- REGISTER -->

                            <a asp-controller="Account"
                               asp-action="Register"
                               class="ml-premium-register">

                                <span>Register</span>

                                <i class="fas fa-arrow-right"></i>

                            </a>

                        }

                    </div>

                </div>

            </div>

        </div>

    </header>



    <!-- =========================================================
         MAIN CONTENT
         IMPORTANT:
         RenderBody MUST come before footer
         ========================================================= -->

    <main role="main">

        @RenderBody()

    </main>



    <!-- =========================================================
         MARKETLINK FOOTER
         ========================================================= -->

    <footer class="ml-footer">

        <div class="container">

            <div class="ml-footer-main">


                <!-- =================================================
                     BRAND
                     ================================================= -->

                <div class="ml-footer-brand">

                    <a asp-controller="Home"
                       asp-action="Index"
                       class="ml-footer-logo">

                        <span class="ml-footer-logo-mark">

                            <i class="fas fa-leaf"></i>

                        </span>

                        <span>
                            Market<span>Link</span>
                        </span>

                    </a>


                    <p>
                        Connecting local vendors with customers
                        and making fresh products easier to discover,
                        order and enjoy.
                    </p>


                    <!-- SOCIAL -->

                    <div class="ml-footer-social">

                        <a href="#"
                           aria-label="Facebook">

                            <i class="fab fa-facebook-f"></i>

                        </a>

                        <a href="#"
                           aria-label="Instagram">

                            <i class="fab fa-instagram"></i>

                        </a>

                        <a href="#"
                           aria-label="Twitter">

                            <i class="fab fa-x-twitter"></i>

                        </a>

                        <a href="#"
                           aria-label="LinkedIn">

                            <i class="fab fa-linkedin-in"></i>

                        </a>

                    </div>

                </div>



                <!-- =================================================
                     QUICK LINKS
                     ================================================= -->

                <div class="ml-footer-column">

                    <h4>
                        Quick Links
                    </h4>


                    <a asp-controller="Home"
                       asp-action="Index">

                        Home

                    </a>


                    <a asp-controller="Home"
                       asp-action="About">

                        About Us

                    </a>


                    <a asp-controller="Products"
                       asp-action="Index">

                        Products

                    </a>


                    <a asp-controller="Categories"
                       asp-action="Index">

                        Categories

                    </a>

                </div>



                <!-- =================================================
                     MARKETPLACE
                     ================================================= -->

                <div class="ml-footer-column">

                    <h4>
                        Marketplace
                    </h4>


                    <a asp-controller="Vendors"
                       asp-action="Index">

                        Vendors

                    </a>


                    <a asp-controller="Account"
                       asp-action="Register">

                        Create Account

                    </a>


                    <a asp-controller="Account"
                       asp-action="VendorRegister">

                        Become a Vendor

                    </a>


                    <a asp-controller="Account"
                       asp-action="Login">

                        Login

                    </a>

                </div>



                <!-- =================================================
                     CONTACT
                     ================================================= -->

                <div class="ml-footer-column ml-footer-contact">

                    <h4>
                        Contact Us
                    </h4>


                    <div class="ml-footer-contact-item">

                        <span>
                            <i class="fas fa-location-dot"></i>
                        </span>

                        <p>
                            Karachi, Pakistan
                        </p>

                    </div>


                    <div class="ml-footer-contact-item">

                        <span>
                            <i class="fas fa-envelope"></i>
                        </span>

                        <p>
                            info@marketlink.com
                        </p>

                    </div>


                    <div class="ml-footer-contact-item">

                        <span>
                            <i class="fas fa-phone"></i>
                        </span>

                        <p>
                            +92 300 0000000
                        </p>

                    </div>

                </div>

            </div>



            <!-- =================================================
                 FOOTER BOTTOM
                 ================================================= -->

            <div class="ml-footer-bottom">

                <p>
                    © @DateTime.Now.Year MarketLink.
                    All rights reserved.
                </p>


                <div class="ml-footer-bottom-links">

                    <a href="#">
                        Privacy Policy
                    </a>

                    <a href="#">
                        Terms & Conditions
                    </a>

                </div>

            </div>

        </div>

    </footer>



    <!-- =========================================================
         BOOTSTRAP JS
         ========================================================= -->

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>



    <!-- =========================================================
         MOBILE NAVBAR SCRIPT
         ONLY ONE SCRIPT IS NEEDED
         ========================================================= -->

    <script>

        document.addEventListener("DOMContentLoaded", function () {

            const button =
                document.getElementById("mlMobileButton");

            const menu =
                document.getElementById("mlPremiumMenu");


            if (!button || !menu) {
                return;
            }


            button.addEventListener("click", function () {

                menu.classList.toggle("open");

                button.classList.toggle("open");


                const opened =
                    menu.classList.contains("open");


                button.setAttribute(
                    "aria-expanded",
                    opened
                );

            });

        });

    </script>



    <!-- =========================================================
         PAGE SPECIFIC SCRIPTS
         ========================================================= -->
    @await RenderSectionAsync("Scripts", required: false)


</body>

</html>
