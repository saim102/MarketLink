@model IdentityDemoApp.Models.WeeklyStock

@{
    ViewData["Title"] = "Edit Weekly Stock";
    Layout = "_Layout";
}
<link rel="stylesheet" href="~/css/vendor-weekly-stock.css" />

<div class="weekly-form-page">

    <div class="weekly-form-header">
        <div>
            <a asp-action="WeeklyStock" class="back-link">
                <i class="fa-solid fa-arrow-left"></i>
                Back to Weekly Stock
            </a>

            <span class="page-eyebrow">
                <i class="fa-solid fa-pen-to-square"></i>
                Inventory Management
            </span>

            <h1>Edit Weekly Stock</h1>

            <p>
                Update the weekly availability of your product.
            </p>
        </div>
    </div>

    <div class="weekly-form-layout">

        <div class="weekly-form-card">

            <div class="form-card-header">
                <div class="form-header-icon">
                    <i class="fa-solid fa-boxes-stacked"></i>
                </div>

                <div>
                    <h2>Update Stock Information</h2>
                    <p>Change the details you want to update.</p>
                </div>
            </div>

            <form asp-action="WeeklyStockEdit"
                  asp-route-id="@Model.WeeklyStockId"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       asp-for="WeeklyStockId" />

                <div asp-validation-summary="ModelOnly"
                     class="validation-summary"></div>

                <div class="form-grid">

                    <div class="form-group full-width">
                        <label asp-for="ProductId">
                            Product
                            <span>*</span>
                        </label>

                        <div class="input-wrapper">
                            <i class="fa-solid fa-leaf"></i>

                            <select asp-for="ProductId"
                                    class="form-control">

                                <option value="">Select Product</option>

                                @if (ViewBag.Products != null)
                                {
                                    foreach (var product in ViewBag.Products)
                                    {
                                        <option value="@product.ProductId">
                                            @product.ProductName
                                            @if (product.Category != null)
                                            {
                                                @: — @product.Category.CategoryName
                                            }
                                        </option>
                                    }
                                }

                            </select>
                        </div>

                        <span asp-validation-for="ProductId"
                              class="field-validation"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="WeekStartDate">
                            Week Start Date
                            <span>*</span>
                        </label>

                        <div class="input-wrapper">
                            <i class="fa-regular fa-calendar"></i>

                            <input asp-for="WeekStartDate"
                                   type="date"
                                   class="form-control" />
                        </div>

                        <span asp-validation-for="WeekStartDate"
                              class="field-validation"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="AvailableQuantity">
                            Available Quantity
                            <span>*</span>
                        </label>

                        <div class="input-wrapper">
                            <i class="fa-solid fa-cubes"></i>

                            <input asp-for="AvailableQuantity"
                                   type="number"
                                   min="0"
                                   step="0.01"
                                   class="form-control" />
                        </div>

                        <span asp-validation-for="AvailableQuantity"
                              class="field-validation"></span>
                    </div>

                </div>

                <div class="reserved-edit-card">

                    <div class="reserved-edit-icon">
                        <i class="fa-solid fa-lock"></i>
                    </div>

                    <div class="reserved-edit-content">
                        <span>Reserved Quantity</span>

                        <strong>
                            @Model.ReservedQuantity.ToString("0.##")
                        </strong>

                        <p>
                            Reserved quantity cannot be manually changed.
                        </p>
                    </div>

                </div>

                <div class="stock-formula">
                    <span>Remaining Stock</span>

                    <strong>
                        @((Model.AvailableQuantity - Model.ReservedQuantity).ToString("0.##"))
                    </strong>

                    <small>
                        Available − Reserved
                    </small>
                </div>

                <div class="form-actions">

                    <a asp-action="WeeklyStock"
                       class="cancel-btn">
                        Cancel
                    </a>

                    <button type="submit"
                            class="save-btn">
                        <i class="fa-solid fa-floppy-disk"></i>
                        Save Changes
                    </button>

                </div>

            </form>

        </div>

        <div class="weekly-side-card">

            <div class="side-card-icon">
                <i class="fa-solid fa-circle-info"></i>
            </div>

            <h3>Keep Stock Accurate</h3>

            <p>
                Update your quantity whenever your expected weekly stock
                changes so customers can see the correct availability.
            </p>

            <div class="side-rule"></div>

            <div class="side-point">
                <i class="fa-solid fa-circle-check"></i>
                <span>Available quantity cannot be negative.</span>
            </div>

            <div class="side-point">
                <i class="fa-solid fa-circle-check"></i>
                <span>Reserved quantity is protected.</span>
            </div>

            <div class="side-point">
                <i class="fa-solid fa-circle-check"></i>
                <span>Remaining stock is calculated automatically.</span>
            </div>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}