
@model IdentityDemoApp.Models.CustomerProfile

@{
    ViewData["Title"] = "My Profile";
}

<link rel="stylesheet" href="~/css/customer-profile.css" />

<div class="customer-profile-page">

    <div class="profile-topbar">
        <div>
            <span class="profile-label">Account Center</span>
            <h1>My Profile</h1>
            <p>Manage your personal information and account details.</p>
        </div>

        <a asp-controller="Customer"
           asp-action="Dashboard"
           class="profile-back-btn">
            <i class="fa-solid fa-arrow-left"></i>
            Dashboard
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="profile-success">
            <div class="success-icon">
                <i class="fa-solid fa-check"></i>
            </div>
            <div>
                <strong>All set!</strong>
                <span>@TempData["Success"]</span>
            </div>
            <button type="button" onclick="this.parentElement.remove()">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>
    }

    <div class="profile-layout">

        <aside class="profile-sidebar">

            <div class="profile-avatar">
                <span>@(string.IsNullOrWhiteSpace(Model.FullName) ? "C" : Model.FullName.Substring(0, 1).ToUpper())</span>
                <div class="online-dot"></div>
            </div>

            <h2>@Model.FullName</h2>

            <p class="profile-email">
                <i class="fa-regular fa-envelope"></i>
                @Model.User?.Email
            </p>

            <div class="account-status">
                <span></span>
                Active Customer
            </div>

            <div class="profile-divider"></div>

            <div class="profile-side-info">
                <div>
                    <i class="fa-solid fa-calendar-days"></i>
                    <span>Member Since</span>
                    <strong>@Model.CreatedAt.ToString("MMM yyyy")</strong>
                </div>

                <div>
                    <i class="fa-solid fa-location-dot"></i>
                    <span>Location</span>
                    <strong>@(string.IsNullOrWhiteSpace(Model.City) ? "Not added" : Model.City)</strong>
                </div>
            </div>

        </aside>

        <main class="profile-main">

            <div class="profile-card-header">
                <div>
                    <span>Personal Information</span>
                    <h2>Account Details</h2>
                </div>

                <div class="header-icon">
                    <i class="fa-regular fa-user"></i>
                </div>
            </div>

            <form asp-action="Profile"
                  method="post"
                  class="profile-form">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="validation-summary"></div>

                <div class="form-grid">

                    <div class="form-group full-width">
                        <label asp-for="FullName">
                            <i class="fa-regular fa-user"></i>
                            Full Name
                        </label>

                        <div class="input-wrapper">
                            <input asp-for="FullName"
                                   placeholder="Enter your full name"
                                   autocomplete="name" />
                        </div>

                        <span asp-validation-for="FullName"
                              class="field-error"></span>
                    </div>

                    <div class="form-group">
                        <label>
                            <i class="fa-regular fa-envelope"></i>
                            Email Address
                        </label>

                        <div class="input-wrapper disabled-input">
                            <input value="@Model.User?.Email"
                                   readonly
                                   autocomplete="email" />
                            <span class="verified-badge">
                                <i class="fa-solid fa-check"></i>
                            </span>
                        </div>

                        <small>Email address cannot be changed here.</small>
                    </div>

                    <div class="form-group">
                        <label asp-for="ContactNumber">
                            <i class="fa-solid fa-phone"></i>
                            Contact Number
                        </label>

                        <div class="input-wrapper">
                            <input asp-for="ContactNumber"
                                   placeholder="03XX XXXXXXX"
                                   autocomplete="tel" />
                        </div>

                        <span asp-validation-for="ContactNumber"
                              class="field-error"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="City">
                            <i class="fa-solid fa-location-dot"></i>
                            City
                        </label>

                        <div class="input-wrapper">
                            <input asp-for="City"
                                   placeholder="Enter your city"
                                   autocomplete="address-level2" />
                        </div>

                        <span asp-validation-for="City"
                              class="field-error"></span>
                    </div>

                    <div class="form-group full-width">
                        <label asp-for="Address">
                            <i class="fa-solid fa-house"></i>
                            Address
                        </label>

                        <div class="input-wrapper textarea-wrapper">
                            <textarea asp-for="Address"
                                      rows="4"
                                      placeholder="Enter your complete address"
                                      autocomplete="street-address"></textarea>
                        </div>

                        <span asp-validation-for="Address"
                              class="field-error"></span>
                    </div>

                </div>

                <div class="form-footer">
                    <div class="secure-note">
                        <i class="fa-solid fa-shield-halved"></i>
                        <span>Your information is securely stored.</span>
                    </div>

                    <button type="submit"
                            class="save-profile-btn">
                        <i class="fa-solid fa-floppy-disk"></i>
                        Save Changes
                    </button>
                </div>

            </form>

        </main>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

