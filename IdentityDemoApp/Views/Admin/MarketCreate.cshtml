```cshtml
@model IdentityDemoApp.Models.Market

@{
    ViewData["Title"] = "Add Market";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet"
      href="~/css/admin-Markets.css"
      asp-append-version="true" />

<link rel="stylesheet"
      href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

<div class="market-form-page">

    <div class="form-page-header">

        <div>

            <a asp-controller="Admin"
               asp-action="Markets"
               class="back-link">
                <i class="fas fa-arrow-left"></i>
                Back to Markets
            </a>

            <span class="page-label">
                <i class="fas fa-plus-circle"></i>
                MARKET MANAGEMENT
            </span>

            <h1>Add New Market</h1>

            <p>
                Create a new market for vendors.
            </p>

        </div>

    </div>


    <div class="market-form-card">

        <div class="form-card-heading">

            <div class="form-heading-icon">
                <i class="fas fa-store"></i>
            </div>

            <div>
                <h3>Market Information</h3>

                <p>
                    Enter the location, operating hours and other market details.
                </p>
            </div>

        </div>


        <form asp-controller="Admin"
              asp-action="MarketCreate"
              method="post">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="validation-summary"></div>


            <div class="form-grid">

                <div class="form-group">

                    <label asp-for="MarketName">
                        Market Name <span>*</span>
                    </label>

                    <div class="input-wrapper">

                        <i class="fas fa-store"></i>

                        <input asp-for="MarketName"
                               placeholder="Enter market name" />

                    </div>

                    <span asp-validation-for="MarketName"
                          class="field-error"></span>

                </div>


                <div class="form-group">

                    <label asp-for="Location">
                        Location / Address <span>*</span>
                    </label>

                    <div class="input-wrapper">

                        <i class="fas fa-location-dot"></i>

                        <input asp-for="Location"
                               placeholder="Enter market address or location" />

                    </div>

                    <span asp-validation-for="Location"
                          class="field-error"></span>

                </div>


                <div class="form-group">

                    <label asp-for="City">
                        City
                    </label>

                    <div class="input-wrapper">

                        <i class="fas fa-city"></i>

                        <input asp-for="City"
                               placeholder="Enter city" />

                    </div>

                    <span asp-validation-for="City"
                          class="field-error"></span>

                </div>


                <div class="form-group">

                    <label asp-for="OperatingDays">
                        Operating Days
                    </label>

                    <div class="input-wrapper">

                        <i class="fas fa-calendar-days"></i>

                        <input asp-for="OperatingDays"
                               placeholder="e.g. Monday, Wednesday, Saturday" />

                    </div>

                    <span class="field-hint">
                        Enter the days when this market operates.
                    </span>

                    <span asp-validation-for="OperatingDays"
                          class="field-error"></span>

                </div>


                <div class="form-group">

                    <label asp-for="OpeningTime">
                        Opening Time
                    </label>

                    <div class="input-wrapper">

                        <i class="fas fa-clock"></i>

                        <input asp-for="OpeningTime"
                               type="time" />

                    </div>

                    <span asp-validation-for="OpeningTime"
                          class="field-error"></span>

                </div>


                <div class="form-group">

                    <label asp-for="ClosingTime">
                        Closing Time
                    </label>

                    <div class="input-wrapper">

                        <i class="fas fa-clock"></i>

                        <input asp-for="ClosingTime"
                               type="time" />

                    </div>

                    <span class="field-hint">
                        Closing time must be later than opening time.
                    </span>

                    <span asp-validation-for="ClosingTime"
                          class="field-error"></span>

                </div>


                <div class="form-group">

                    <label asp-for="Latitude">
                        Latitude
                    </label>

                    <div class="input-wrapper">

                        <i class="fas fa-map-pin"></i>

                        <input asp-for="Latitude"
                               id="Latitude"
                               type="number"
                               step="0.000001"
                               placeholder="Select location from map" />

                    </div>

                    <span class="field-hint">
                        Filled automatically from the map.
                    </span>

                </div>


                <div class="form-group">

                    <label asp-for="Longitude">
                        Longitude
                    </label>

                    <div class="input-wrapper">

                        <i class="fas fa-map-pin"></i>

                        <input asp-for="Longitude"
                               id="Longitude"
                               type="number"
                               step="0.000001"
                               placeholder="Select location from map" />

                    </div>

                    <span class="field-hint">
                        Filled automatically from the map.
                    </span>

                </div>


                <!-- MAP -->

                <div class="form-group full-width">

                    <div class="market-map-header">

                        <div>

                            <label>
                                <i class="fas fa-map-location-dot"></i>
                                Select Market Location
                            </label>

                            <p>
                                Search for a location or click the map to place the market marker.
                            </p>

                        </div>

                        <button type="button"
                                id="useLocationBtn"
                                class="map-location-btn">

                            <i class="fas fa-crosshairs"></i>
                            <span>Use My Location</span>

                        </button>

                    </div>


                    <div class="market-map-search">

                        <div class="map-search-box">

                            <i class="fas fa-search"></i>

                            <input type="text"
                                   id="mapSearch"
                                   placeholder="Search market location..." />

                        </div>

                        <button type="button"
                                id="mapSearchBtn"
                                class="map-search-btn">

                            <i class="fas fa-search"></i>
                            <span>Search</span>

                        </button>

                    </div>


                    <div id="marketMap"
                         class="market-map">
                    </div>


                    <div class="map-selected-info">

                        <div class="map-info-card">

                            <i class="fas fa-location-dot"></i>

                            <div>

                                <span>Selected Coordinates</span>

                                <strong id="selectedCoordinates">
                                    No location selected
                                </strong>

                            </div>

                        </div>


                        <div class="map-info-card">

                            <i class="fas fa-arrows-up-down-left-right"></i>

                            <div>

                                <span>Map Tip</span>

                                <strong>
                                    Click or drag marker
                                </strong>

                            </div>

                        </div>

                    </div>

                </div>


                <!-- MAP LINK -->

                <div class="form-group full-width">

                    <label asp-for="MapLink">
                        Map Link
                    </label>

                    <div class="input-wrapper">

                        <i class="fas fa-map-location-dot"></i>

                        <input asp-for="MapLink"
                               id="MapLink"
                               type="url"
                               placeholder="Generated automatically from map" />

                    </div>

                    <span class="field-hint">
                        Automatically generated from the selected map location.
                    </span>

                </div>


                <div class="form-group full-width">

                    <label asp-for="Description">
                        Description
                    </label>

                    <div class="textarea-wrapper">

                        <i class="fas fa-align-left"></i>

                        <textarea asp-for="Description"
                                  rows="5"
                                  placeholder="Enter market description"></textarea>

                    </div>

                    <span asp-validation-for="Description"
                          class="field-error"></span>

                </div>


                <div class="form-group full-width">

                    <label class="toggle-label">
                        Market Status
                    </label>

                    <label class="switch-container">

                        <input asp-for="IsActive" />

                        <span class="switch-slider"></span>

                        <span class="switch-text">
                            Active Market
                        </span>

                    </label>

                </div>

            </div>


            <div class="form-actions">

                <a asp-controller="Admin"
                   asp-action="Markets"
                   class="btn-cancel">
                    Cancel
                </a>

                <button type="submit"
                        class="btn-save">

                    <i class="fas fa-check"></i>
                    Save Market

                </button>

            </div>

        </form>

    </div>

</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

    <script>

        document.addEventListener("DOMContentLoaded", function () {

            const latitudeInput =
                document.getElementById("Latitude");

            const longitudeInput =
                document.getElementById("Longitude");

            const mapLinkInput =
                document.getElementById("MapLink");

            const coordinatesText =
                document.getElementById("selectedCoordinates");

            const mapSearch =
                document.getElementById("mapSearch");

            const mapSearchBtn =
                document.getElementById("mapSearchBtn");

            const useLocationBtn =
                document.getElementById("useLocationBtn");


            const defaultLatitude = 24.8607;
            const defaultLongitude = 67.0011;


            const map = L.map("marketMap").setView(
                [defaultLatitude, defaultLongitude],
                12
            );


            L.tileLayer(
                "https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png",
                {
                    maxZoom: 19,
                    attribution: "&copy; OpenStreetMap contributors"
                }
            ).addTo(map);


            let marker = null;


            function updateLocation(lat, lng) {

                const latitude =
                    Number(lat).toFixed(6);

                const longitude =
                    Number(lng).toFixed(6);


                latitudeInput.value = latitude;

                longitudeInput.value = longitude;


                mapLinkInput.value =
                    "https://www.openstreetmap.org/?mlat=" +
                    latitude +
                    "&mlon=" +
                    longitude +
                    "#map=18/" +
                    latitude +
                    "/" +
                    longitude;


                coordinatesText.textContent =
                    latitude + ", " + longitude;

            }


            function setMarker(lat, lng) {

                if (marker) {

                    marker.setLatLng([
                        lat,
                        lng
                    ]);

                }
                else {

                    marker = L.marker(
                        [lat, lng],
                        {
                            draggable: true
                        }
                    ).addTo(map);


                    marker.bindPopup(
                        "<strong>Market Location</strong><br>Drag to adjust."
                    );


                    marker.on(
                        "dragend",
                        function () {

                            const position =
                                marker.getLatLng();

                            updateLocation(
                                position.lat,
                                position.lng
                            );

                        }
                    );

                }


                updateLocation(
                    lat,
                    lng
                );


                map.setView(
                    [lat, lng],
                    16
                );

            }


            map.on(
                "click",
                function (event) {

                    setMarker(
                        event.latlng.lat,
                        event.latlng.lng
                    );

                }
            );


            mapSearchBtn.addEventListener(
                "click",
                searchLocation
            );


            mapSearch.addEventListener(
                "keydown",
                function (event) {

                    if (event.key === "Enter") {

                        event.preventDefault();

                        searchLocation();

                    }

                }
            );


            async function searchLocation() {

                const query =
                    mapSearch.value.trim();


                if (!query) {

                    alert(
                        "Please enter a location to search."
                    );

                    return;

                }


                const originalText =
                    mapSearchBtn.innerHTML;


                mapSearchBtn.disabled = true;

                mapSearchBtn.innerHTML =
                    '<i class="fas fa-spinner fa-spin"></i> Searching...';


                try {

                    const response =
                        await fetch(
                            "https://nominatim.openstreetmap.org/search?format=json&limit=1&q=" +
                            encodeURIComponent(query)
                        );


                    const results =
                        await response.json();


                    if (!results.length) {

                        alert(
                            "Location not found. Try a more specific address."
                        );

                        return;

                    }


                    const result =
                        results[0];


                    setMarker(
                        parseFloat(result.lat),
                        parseFloat(result.lon)
                    );

                }
                catch {

                    alert(
                        "Unable to search this location."
                    );

                }
                finally {

                    mapSearchBtn.disabled = false;

                    mapSearchBtn.innerHTML =
                        originalText;

                }

            }


            useLocationBtn.addEventListener(
                "click",
                function () {

                    if (!navigator.geolocation) {

                        alert(
                            "Location services are not supported by this browser."
                        );

                        return;

                    }


                    const originalText =
                        useLocationBtn.innerHTML;


                    useLocationBtn.disabled = true;

                    useLocationBtn.innerHTML =
                        '<i class="fas fa-spinner fa-spin"></i> Locating...';


                    navigator.geolocation.getCurrentPosition(

                        function (position) {

                            setMarker(
                                position.coords.latitude,
                                position.coords.longitude
                            );


                            useLocationBtn.disabled = false;

                            useLocationBtn.innerHTML =
                                originalText;

                        },

                        function () {

                            alert(
                                "Location permission was not granted."
                            );


                            useLocationBtn.disabled = false;

                            useLocationBtn.innerHTML =
                                originalText;

                        },

                        {
                            enableHighAccuracy: true,
                            timeout: 10000,
                            maximumAge: 0
                        }

                    );

                }
            );


            setTimeout(
                function () {

                    map.invalidateSize();

                },
                300
            );

        });

    </script>
}
```
