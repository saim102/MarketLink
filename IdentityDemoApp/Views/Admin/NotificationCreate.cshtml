@{
    ViewData["Title"] = "Create Announcement";

    var title = ViewBag.Title as string ?? "";
    var message = ViewBag.Message as string ?? "";
    var notificationType = ViewBag.NotificationType as string ?? "";
    var audience = ViewBag.Audience as string ?? "";
}

<link rel="stylesheet"
      href="~/css/admin-Notifications.css"
      asp-append-version="true" />

<div class="notification-page">

    
    <div class="notification-header">

        <div class="notification-heading">

            <div class="notification-icon-box">
                <i class="fas fa-bullhorn"></i>
            </div>

            <div>

                <h1>Create Announcement</h1>

                <p>
                    Publish an announcement to farmers or customers.
                </p>

            </div>

        </div>


        <div class="notification-header-actions">

            <a asp-controller="Admin"
               asp-action="Dashboard"
               class="notification-dashboard-btn">

                <i class="fas fa-arrow-left"></i>
                <span>Back to Dashboard</span>

            </a>

            <a asp-controller="Admin"
               asp-action="Notifications"
               class="notification-back-btn">

                <i class="fas fa-bell"></i>
                <span>Notifications</span>

            </a>

        </div>

    </div>


 
    <div class="notification-form-card">

        <div class="notification-form-header">

            <div class="notification-form-icon">
                <i class="fas fa-paper-plane"></i>
            </div>

            <div>

                <h2>Publish New Announcement</h2>

                <p>
                    Fill in the information below and select who should receive it.
                </p>

            </div>

        </div>


        <form asp-controller="Admin"
              asp-action="NotificationCreate"
              method="post"
              id="notificationCreateForm">

            @Html.AntiForgeryToken()


            <div asp-validation-summary="ModelOnly"
                 class="notification-validation">
            </div>


           
            <div class="notification-form-group">

                <label for="title">
                    Announcement Title
                    <span>*</span>
                </label>

                <div class="notification-field">

                    <i class="fas fa-heading"></i>

                    <input type="text"
                           id="title"
                           name="title"
                           value="@title"
                           maxlength="200"
                           placeholder="Enter announcement title"
                           required />

                </div>

                <span class="notification-field-hint">
                    Maximum 200 characters.
                </span>

            </div>


        
            <div class="notification-form-group">

                <label for="message">
                    Message
                    <span>*</span>
                </label>

                <div class="notification-textarea-field">

                    <i class="fas fa-align-left"></i>

                    <textarea id="message"
                              name="message"
                              maxlength="1000"
                              rows="7"
                              placeholder="Write your announcement message..."
                              required>@message</textarea>

                </div>

                <span class="notification-field-hint">
                    Maximum 1000 characters.
                </span>

            </div>


            <div class="notification-form-grid">


              
                <div class="notification-form-group">

                    <label for="notificationType">
                        Notification Type
                        <span>*</span>
                    </label>

                    <div class="notification-field">

                        <i class="fas fa-tag"></i>

                        <select id="notificationType"
                                name="notificationType"
                                required>

                            <option value="">
                                Select Type
                            </option>

                            <option value="Announcement"
                                    selected="@(notificationType == "Announcement")">
                                Announcement
                            </option>

                            <option value="General"
                                    selected="@(notificationType == "General")">
                                General
                            </option>

                            <option value="Order"
                                    selected="@(notificationType == "Order")">
                                Order
                            </option>

                            <option value="System"
                                    selected="@(notificationType == "System")">
                                System
                            </option>

                        </select>

                    </div>

                </div>


              
                <div class="notification-form-group">

                    <label for="audience">
                        Send To
                        <span>*</span>
                    </label>

                    <div class="notification-field">

                        <i class="fas fa-users"></i>

                        <select id="audience"
                                name="audience"
                                required>

                            <option value="">
                                Select Audience
                            </option>

                            <option value="All"
                                    selected="@(audience == "All")">
                                All Users
                            </option>

                            <option value="Farmers"
                                    selected="@(audience == "Farmers")">
                                Farmers
                            </option>

                            <option value="Customers"
                                    selected="@(audience == "Customers")">
                                Customers
                            </option>

                        </select>

                    </div>

                </div>

            </div>


           
            <div class="notification-info-box">

                <div class="notification-info-icon">
                    <i class="fas fa-circle-info"></i>
                </div>

                <div>

                    <strong>How publishing works</strong>

                    <p>
                        When you publish this announcement, a notification
                        will automatically be created for every active user
                        in the selected audience.
                    </p>

                </div>

            </div>


           
            <div class="notification-form-actions">

                <a asp-controller="Admin"
                   asp-action="Notifications"
                   class="notification-cancel-btn">

                    <i class="fas fa-xmark"></i>
                    Cancel

                </a>

                <button type="submit"
                        class="notification-publish-btn">

                    <i class="fas fa-paper-plane"></i>
                    Publish Announcement

                </button>

            </div>

        </form>

    </div>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>

        document.getElementById('notificationCreateForm')
            .addEventListener('submit', function (e) {

                const title =
                    document.getElementById('title').value.trim();

                const message =
                    document.getElementById('message').value.trim();

                const type =
                    document.getElementById('notificationType').value;

                const audience =
                    document.getElementById('audience').value;


                if (!title || !message || !type || !audience) {

                    e.preventDefault();

                    Swal.fire({
                        icon: 'warning',
                        title: 'Incomplete Form',
                        text: 'Please fill all required fields.',
                        confirmButtonColor: '#0B3037'
                    });

                }

            });

    </script>

}