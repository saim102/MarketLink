
@model IEnumerable<IdentityDemoApp.Models.VendorProfile>

@{
    ViewData["Title"] = "Vendors";
}

<div class="container-fluid py-4">

   

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">Vendors</h2>

            <p class="text-muted mb-0">
                Manage vendor registrations and approvals
            </p>
        </div>

        <div class="d-flex align-items-center gap-2">

           

            <a asp-controller="Admin"
               asp-action="Dashboard"
               class="btn btn-outline-secondary">

                <i class="fas fa-arrow-left me-1"></i>
                Back to Dashboard

            </a>

         

            <span class="badge bg-warning text-dark px-3 py-2">

                Pending:
                @Model.Count(v => !v.IsApproved)

            </span>

        </div>

    </div>


    

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">

            <i class="fas fa-circle-check me-1"></i>

            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <



    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">

            <i class="fas fa-circle-exclamation me-1"></i>

            @TempData["Error"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


   

    <div class="card shadow-sm border-0">

        <div class="card-body">

            @if (!Model.Any())
            {
                <div class="text-center py-5">

                    <i class="fas fa-store fa-3x text-muted mb-3"></i>

                    <h5>No Vendors Found</h5>

                    <p class="text-muted">
                        No vendor registrations are available.
                    </p>

                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table align-middle">

                        <thead>
                            <tr>

                                <th>Vendor</th>
                                <th>Email</th>
                                <th>Farm / Business</th>
                                <th>Address</th>
                                <th>Registered</th>
                                <th>Status</th>
                                <th class="text-end">Actions</th>

                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var vendor in Model)
                            {
                                <tr>

                                 

                                    <td>
                                        <strong>
                                            @(vendor.User?.FullName ?? "N/A")
                                        </strong>
                                    </td>


                               

                                    <td>
                                        @(vendor.User?.Email ?? "N/A")
                                    </td>


                                  
                          

                                    <td>
                                        @vendor.FarmName
                                    </td>


                                

                                    <td>
                                        @vendor.Address
                                    </td>


                                 
                                    <td>
                                        <strong>
                                            @vendor.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")
                                        </strong>
                                    </td>
                                 



                              

                                    <td>

                                        @if (vendor.IsApproved)
                                        {
                                            <span class="badge bg-success">
                                                Approved
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">
                                                Pending
                                            </span>
                                        }

                                    </td>


                             

                                    <td class="text-end">

                                      

                                        <a asp-controller="Admin"
                                           asp-action="VendorDetails"
                                           asp-route-id="@vendor.VendorProfileId"
                                           class="btn btn-sm btn-outline-primary">

                                            <i class="fas fa-eye"></i>
                                            View

                                        </a>


                                    

                                        @if (!vendor.IsApproved)
                                        {
                                            <form asp-controller="Admin"
                                                  asp-action="ApproveVendor"
                                                  asp-route-id="@vendor.VendorProfileId"
                                                  method="post"
                                                  class="d-inline">

                                                @Html.AntiForgeryToken()

                                                <button type="submit"
                                                        class="btn btn-sm btn-success">

                                                    <i class="fas fa-check"></i>
                                                    Approve

                                                </button>

                                            </form>
                                        }
                                        else
                                        {
                                            <form asp-controller="Admin"
                                                  asp-action="RejectVendor"
                                                  asp-route-id="@vendor.VendorProfileId"
                                                  method="post"
                                                  class="d-inline">

                                                @Html.AntiForgeryToken()

                                                <button type="submit"
                                                        class="btn btn-sm btn-danger">

                                                    <i class="fas fa-times"></i>
                                                    Reject

                                                </button>

                                            </form>
                                        }


                                      

                                        <form asp-controller="Admin"
                                              asp-action="DeleteVendor"
                                              asp-route-id="@vendor.VendorProfileId"
                                              method="post"
                                              class="d-inline"
                                              onsubmit="return confirm('Are you sure you want to delete this vendor?');">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-danger"
                                                    title="Delete Vendor">

                                                <i class="fas fa-trash"></i>
                                                Delete

                                            </button>

                                        </form>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>

</div>

